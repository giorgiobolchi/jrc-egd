        <attvalues>
          <attvalue for="0" value="TA6" />
          <attvalue for="1" value="Terrestrial Ecosystems Restoration - Rivers" />
          <attvalue for="2" value="Natural connectivity of rivers and natural functions of the related floodplains. Member States shall make an inventory of artificial barriers and remove them to connectivity of surface waters" />
          <attvalue for="3" value="source" />
        </attvalues>
