        <attvalues>
          <attvalue for="0" value="TA2" />
          <attvalue for="1" value="Renewable Energy" />
          <attvalue for="2" value="Member States shall collectively ensure that the share of energy from renewable sources in the Union‚Äö√Ñ√¥s gross final consumption of energy in 2030 is at least 42.5%" />
