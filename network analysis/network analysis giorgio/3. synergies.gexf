        <attvalues>
          <attvalue for="0" value="TA4" />
          <attvalue for="1" value="Energy Infrastructure" />
          <attvalue for="2" value="Member States shall ensure that, at the end of each year, the following power output targets are met cumulatively: (a) for each light-duty battery electric vehicle registered in their territory, a total power output of at least 1.3 kW is provided through publicly accessible recharging stations, and (b) for each light-duty plug-in hybrid vehicle registered in their territory, a total power output of at least 0.80 kW is provided through publicly accessible recharging stations. Regulation (EU) 2023/1804" />
          <attvalue for="3" value="source" />
        </attvalues>
      </node>
