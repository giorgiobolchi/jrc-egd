    <nodes>
      <node id="TA2.41" label="TA2.41">
        <attvalues>
          <attvalue for="0" value="TA2" />
          <attvalue for="1" value="Energy Efficiency" />
          <attvalue for="2" value="Member States are required to achieve cumulative end-use energy savings from 2021 to 2030, equivalent to new annual savings of at least 0.8% of final energy consumption in 2021-2023, at least 1.3% in 2024-2025, 1.5% in 2026-2027 and 1.9% in 2028-2030. Directive (EU) 2023/1791" />
          <attvalue for="3" value="impact" />
        </attvalues>
      </node>
      <node id="TA3.3" label="TA3.3">
        <attvalues>
          <attvalue for="0" value="TA3" />
