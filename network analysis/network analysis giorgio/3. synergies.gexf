          <attvalue for="0" value="TA6" />
          <attvalue for="1" value="Terrestrial Ecosystems Restoration" />
          <attvalue for="2" value="Terrestrial, coastal and freshwater ecosystems. Member States shall ensure that there is: (a) an increase of habitat area in good condition for habitat types listed in Annex I" />
          <attvalue for="3" value="impact" />
        </attvalues>
      </node>
      <node id="TA6.16" label="TA6.16">
        <attvalues>
          <attvalue for="0" value="TA6" />
          <attvalue for="1" value="Biodiversity Protection &amp; Conservation - Urban Nature" />
          <attvalue for="2" value="14. Cities with at least 20.000 inhabitants have an ambitious Urban Greening Plan" />
          <attvalue for="3" value="source" />
        </attvalues>
      </node>
      <node id="TA6.36" label="TA6.36">
        <attvalues>
          <attvalue for="0" value="TA6" />
          <attvalue for="1" value="Biodiversity Protection &amp; Conservation - Urban Nature" />
          <attvalue for="2" value="(urban ecosystems) By 2030, Member States shall ensure that there is no net loss in the total national area of urban green space, and of urban tree canopy cover in urban ecosystem areas." />
          <attvalue for="3" value="source" />
        </attvalues>
      </node>
      <node id="TA6.62" label="TA6.62">
        <attvalues>
          <attvalue for="0" value="TA6" />
          <attvalue for="1" value="Improve Water Quality" />
          <attvalue for="2" value="The Water Reuse Regulation aim to encourage and facilitate water reuse in the EU" />
          <attvalue for="3" value="impact" />
        </attvalues>
      </node>
      <node id="TA6.31" label="TA6.31">
        <attvalues>
          <attvalue for="0" value="TA6" />
          <attvalue for="1" value="Terrestrial Ecosystems Restoration" />
          <attvalue for="2" value="Terrestrial, coastal and freshwater ecosystems. Member States shall put in place the restoration measures [...] to improve to good condition areas of habitat types listed in Annex I which are not in good condition" />
          <attvalue for="3" value="source" />
        </attvalues>
      </node>
      <node id="TA6.32" label="TA6.32">
        <attvalues>
          <attvalue for="0" value="TA6" />
          <attvalue for="1" value="Terrestrial Ecosystems Restoration" />
          <attvalue for="2" value="Terrestrial, coastal and freshwater ecosystems. Member States shall put in place the restoration measures [...] to re-establish the habitat types listed in Annex I in areas not covered by those habitat types" />
          <attvalue for="3" value="source" />
        </attvalues>
      </node>
      <node id="TA6.38" label="TA6.38">
        <attvalues>
          <attvalue for="0" value="TA6" />
          <attvalue for="1" value="Biodiversity Protection &amp; Conservation - Urban Nature" />
          <attvalue for="2" value="(urban ecosystems) Member States shall achieve, in each urban ecosystem area, determined in accordance with Article 14(4), an increasing trend of urban tree canopy cover" />
          <attvalue for="3" value="source" />
        </attvalues>
      </node>
      <node id="TA5.8" label="TA5.8">
        <attvalues>
          <attvalue for="0" value="TA5" />
          <attvalue for="1" value="Improve Water Quality" />
          <attvalue for="2" value="Water: Preserving freshwater, boosting water reuse in agriculture." />
          <attvalue for="3" value="source" />
        </attvalues>
      </node>
      <node id="TA5.19" label="TA5.19">
        <attvalues>
          <attvalue for="0" value="TA5" />
          <attvalue for="1" value="Food affordability" />
          <attvalue for="2" value="Price: Preserve the price affordability of food." />
          <attvalue for="3" value="source" />
        </attvalues>
      </node>
      <node id="TA2.2" label="TA2.2">
        <attvalues>
          <attvalue for="0" value="TA2" />
          <attvalue for="1" value="Renewable Energy" />
          <attvalue for="2" value="Set up at least one renewables-based energy community in every municipality with a population higher than 10.000 by 2025" />
          <attvalue for="3" value="impact" />
        </attvalues>
      </node>
      <node id="TA6.43" label="TA6.43">
        <attvalues>
          <attvalue for="0" value="TA6" />
          <attvalue for="1" value="Biodiversity Protection &amp; Conservation - Monitoring" />
          <attvalue for="2" value="Marine ecosystems. Member States shall ensure, by 2030 at the latest, that the condition is known for at least 50% of the area distributed over all habitat types listed in groups 1‚Äì6 of Annex II." />
          <attvalue for="3" value="impact" />
        </attvalues>
      </node>
      <node id="TA5.10" label="TA5.10">
        <attvalues>
          <attvalue for="0" value="TA5" />
          <attvalue for="1" value="Renewable Energy" />
          <attvalue for="2" value="Energy: Increase renewable energy in the agriculture and food sector. Adopt energy efficiency solutions in the agriculture and food sector, by reducing energy consumption." />
          <attvalue for="3" value="source" />
        </attvalues>
      </node>
      <node id="TA2.11" label="TA2.11">
        <attvalues>
          <attvalue for="0" value="TA2" />
          <attvalue for="1" value="Renewable Energy" />
          <attvalue for="2" value="By 31 December 2025, each Member State shall agree to establish a framework for cooperation on joint projects with one or more other Member States for the production of renewable energy" />
          <attvalue for="3" value="source" />
        </attvalues>
      </node>
      <node id="T5.11" label="T5.11">
        <attvalues>
          <attvalue for="0" value="NaN" />
          <attvalue for="1" value="Biodiversity Protection &amp; Conservation" />
          <attvalue for="2" value="Biodiversity conservation and restoration of natural resources: Protect the environment and restore natural resources. Preserve biodiversity and reduce biodiversity loss." />
          <attvalue for="3" value="impact" />
        </attvalues>
      </node>
      <node id="TA5.31" label="TA5.31">
        <attvalues>
          <attvalue for="0" value="TA5" />
          <attvalue for="1" value="Food quality - Healthy Food" />
          <attvalue for="2" value="Properties of food: Increase reformulation of food products in line with guidelines for healthy and sustainable diets" />
          <attvalue for="3" value="source" />
        </attvalues>
      </node>
