          <attvalue for="1" value="Renewable Energy - Hydrogen Production" />
          <attvalue for="2" value="Member States shall ensure that the contribution of renewable fuels of non-biological origin used for final energy and non-energy purposes shall be at least 42% of the hydrogen used for final energy and non-energy purposes in industry by 2030" />
          <attvalue for="3" value="impact" />
