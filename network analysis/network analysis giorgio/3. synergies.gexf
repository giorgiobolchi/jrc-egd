        <attvalues>
          <attvalue for="0" value="TA2" />
          <attvalue for="1" value="Energy Efficiency" />
          <attvalue for="2" value="Member States shall collectively ensure a reduction of energy consumption of at least 11.7% in 2030 compared to the projections of the 2020 EU Reference Scenario" />
          <attvalue for="3" value="impact" />
