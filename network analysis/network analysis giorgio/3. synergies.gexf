          <attvalue for="2" value="Food messaging: Provide food information and labelling to empower consumers to make informed, healthy and sustainable food choices. Strengthen educational messages on the importance of healthy nutrition, sustainable food production and consumption, and reducing food waste" />
          <attvalue for="3" value="source" />
        </attvalues>
