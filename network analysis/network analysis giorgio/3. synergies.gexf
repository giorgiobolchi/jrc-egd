          <attvalue for="0" value="TA3" />
          <attvalue for="1" value="Circularity/Recycling - Vehicle Circularity" />
          <attvalue for="2" value="Each vehicle belonging to a vehicle type that is type-approved as of [the first day of the month following 72 months after the date of entry into force of this Regulation] under Regulation (EU) 2018/858 shall be constructed so that it is: (a) reusable/recyclable to a minimum of 85% by mass, (b) reusable/recoverable to a minimum of 95 % by mass." />
          <attvalue for="3" value="source" />
        </attvalues>
      </node>
