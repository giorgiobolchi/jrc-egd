        <attvalues>
          <attvalue for="0" value="TA4" />
          <attvalue for="1" value="Net-Zero Technology - Road Vehicles" />
          <attvalue for="2" value="For [...] ‚urban buses‚ manufacturers shall comply with the 90% (in the reporting period 2030-2034) and 100% (as from 2035) minimum shares in their fleet of new heavy-duty vehicles Regulation (EU) 2024/1610" />
          <attvalue for="3" value="source" />
        </attvalues>
      </node>
