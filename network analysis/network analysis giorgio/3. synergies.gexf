          <attvalue for="2" value="Member States shall take the necessary measures to attain a recycling target of 50% of aluminium by weight of aluminium contained in packaging waste generated by 31 December 2025 and of 60% by 31 December 2030 Proposal on packaging and packaging waste" />
          <attvalue for="3" value="source" />
        </attvalues>
