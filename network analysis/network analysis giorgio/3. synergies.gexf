        <attvalues>
          <attvalue for="0" value="TA5" />
          <attvalue for="1" value="GHG Reduction" />
          <attvalue for="2" value="Ensure that agriculture, fisheries and aquaculture, and the food value chain contribute to the target of reducing net greenhouse gas emissions to at least 55% below 1990 levels by 2030 and to the achievement of the objective for a climate-neutral Union in 2050." />
          <attvalue for="3" value="source" />
